APP_ENV=test
AUTH_MODE=secure
COOKIE_SECURE=false
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
REFRESH_TOKEN_HMAC_SECRET=replace-with-another-random-secret-at-least-32-characters
POSTGRES_DB=jubileu_rc
POSTGRES_USER=jubileu_rc
POSTGRES_PASSWORD=replace-with-a-random-database-password
DATABASE_URL=postgresql+psycopg://jubileu_rc:replace-with-a-random-database-password@jubileu-db:5432/jubileu_rc
RELEASE_REF=v0.3.0-rc.5
GIT_SHA=replace-with-full-git-sha
ALEMBIC_EXPECTED_REVISION=0020_auth_sessions_rollback_safe
BACKEND_IMAGE_DIGEST=sha256:replace-with-backend-digest
FRONTEND_IMAGE_DIGEST=sha256:replace-with-frontend-digest
BACKEND_IMAGE=ghcr.io/felipedalmolin/projeto-jubileu-backend@sha256:replace-with-backend-digest
FRONTEND_IMAGE=ghcr.io/felipedalmolin/projeto-jubileu-frontend@sha256:replace-with-frontend-digest
POSTGRES_VOLUME_NAME=jubileu-rc5-postgres
NGINX_PORT=18080
RELEASE_ENV_FILE=.env.release

# Keep traces disabled in normal operation. A production canary must explicitly
# attach the API to the private telemetry network before changing this value.
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_TIMEOUT_SECONDS=5
OTEL_TRACES_SAMPLER_ARG=0.1
OTEL_BSP_MAX_QUEUE_SIZE=512
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=128
OTEL_SEMCONV_STABILITY_OPT_IN=http,database
OTEL_SERVICE_NAMESPACE=jubileu
OTEL_SERVICE_NAME=jubileu-api
OTEL_HOST_NAME=app-host
