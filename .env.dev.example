# Development-only defaults for compose.dev.yml.
# Copy to .env.dev if you need local overrides. Do not put real secrets here.

POSTGRES_DB=jubileu_dev
POSTGRES_USER=jubileu_dev
POSTGRES_PASSWORD=change-me-dev-only

JWT_SECRET=change-me-dev-only
REFRESH_TOKEN_HMAC_SECRET=change-me-dev-only-refresh
APP_ENV=development
AUTH_MODE=jwt_compat
COOKIE_SECURE=false

# Keep empty so browser calls use Vite's /api proxy in development.
VITE_API_BASE_URL=

# Local host ports. The main browser entrypoint is NGINX on DEV_HTTP_PORT.
DEV_HTTP_PORT=8080
DEV_VITE_PORT=5173
DEV_API_PORT=8000

# Optional, on-demand OTel pilot. These values are consumed only when
# compose.otel.yml is included and the external app_host_telemetry network exists.
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_TIMEOUT_SECONDS=5
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_BSP_MAX_QUEUE_SIZE=512
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=128
